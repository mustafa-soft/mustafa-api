from http.server import BaseHTTPRequestHandler
import json
import os
import requests

class handler(BaseHTTPRequestHandler):
    def do_POST(self):
        # 1. استلام البيانات من الواجهة الأمامية (index.html)
        content_length = int(self.headers.get('Content-Length', 0))
        post_data = self.rfile.read(content_length)
        
        try:
            data = json.loads(post_data)
            imei = data.get('imei')
        except:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(json.dumps({'error': 'بيانات غير صالحة'}).encode('utf-8'))
            return

        if not imei:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(json.dumps({'error': 'رقم IMEI مطلوب'}).encode('utf-8'))
            return

        # 2. جلب مفتاح API بأمان من متغيرات البيئة (سنضعه في Vercel)
        api_key = os.environ.get('IMEI_UNLOCK_API_KEY')
        
        # ⚠️ ضع هنا الرابط الصحيح من توثيق imei-unlock.net
        api_url = 'https://api.imei-unlock.net/v1/check' 

        headers = {
            'Authorization': f'Bearer {api_key}', # أو الطريقة التي يطلبها الموقع
            'Content-Type': 'application/json'
        }
        payload = {
            'imei': imei
        }

        # 3. إرسال الطلب إلى imei-unlock
        try:
            response = requests.post(api_url, json=payload, headers=headers)
            result = response.json()
            
            # 4. إرجاع النتيجة إلى موقعك (index.html)
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*') # للسماح لموقعك بالاتصال
            self.end_headers()
            self.wfile.write(json.dumps(result).encode('utf-8'))
            
        except Exception as e:
            self.send_response(500)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({'error': str(e)}).encode('utf-8'))